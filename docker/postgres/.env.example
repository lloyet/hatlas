# Copy to docker/postgres/.env (git-ignored) and set a real password.
# Hatlas reads the same value from the HATLAS_DB_PASSWORD environment variable.
HATLAS_DB_PASSWORD=change-me
# Host port; change it if 5432 is already used on this machine.
HATLAS_PG_PORT=5432
# Network roles (init/10-roles.sh, hatlas-webapp Decision 6). Optional in development.
HATLAS_WEBAPP_OWNER_PASSWORD=
HATLAS_WEBAPP_PASSWORD=
HATLAS_PROXY_DB_PASSWORD=
HATLAS_HUB_DB_PASSWORD=
HATLAS_WEB_DB_PASSWORD=
