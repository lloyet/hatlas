# Daily Hatlas backup (database + world). Installed by docs/backup.md §2.
# Adjust User= and the script path to your install.
[Unit]
Description=Hatlas backup (PostgreSQL dump + world copy)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=minecraft
Group=minecraft
EnvironmentFile=/etc/hatlas/backup.env
ExecStart=/opt/hatlas/scripts/backup/hatlas-backup.sh backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
