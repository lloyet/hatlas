# Settings for scripts/backup/hatlas-backup.sh. Copy to /etc/hatlas/backup.env (chmod 600,
# it holds the RCON password) or next to the script as backup.env, or point
# HATLAS_BACKUP_ENV at another file. Every value can also come from the environment.

# Paper server folder (holds world/, world_nether/, world_the_end/, plugins/).
SERVER_DIR=/srv/minecraft/faction
# Where backups go: daily/, weekly/, pre-restore/. Same machine for now (Open Question 25).
BACKUP_DIR=/srv/hatlas-backups
# Folders/files under SERVER_DIR copied with the database (relative paths, space-separated).
BACKUP_PATHS="world world_nether world_the_end plugins/hatlas"

# PostgreSQL in docker compose.
COMPOSE_FILE=/srv/hatlas/docker/postgres/docker-compose.yml
PG_SERVICE=postgres
PG_USER=hatlas
PG_DATABASE=hatlas
# Schemas a normal restore replaces. Everything else (e.g. the website's "web" schema with
# accounts and tickets) is left as it is, so a game restore never rolls back payments.
# "hatlas" since M2 feat/web-read-model (storage.postgresql.schema); "public" for an older install not started since.
GAME_SCHEMAS=hatlas

# RCON of the Paper server (server.properties: enable-rcon=true, rcon.password=...).
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=change-me

# Rotation.
KEEP_DAILY=7
KEEP_WEEKLY=4

# Tools (e.g. DOCKER="sudo docker" if the backup user is not in the docker group).
DOCKER=docker
PYTHON=python3
