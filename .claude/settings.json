{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki-on-feature.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking for a finished feature (wiki)"
          }
        ]
      }
    ]
  }
}
